<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegistroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloRegistro"
            style="@style/TituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/titulo_registro" />

        <TextView
            android:id="@+id/txtSubtituloRegistro"
            style="@style/SubtituloPantalla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/subtitulo_registro" />

        <EditText
            android:id="@+id/edtNombreRegistro"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:autofillHints="name"
            android:hint="@string/hint_nombre"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/edtCorreoRegistro"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="emailAddress"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/edtPresupuestoRegistro"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_presupuesto_mensual"
            android:importantForAutofill="no"
            android:inputType="number" />

        <EditText
            android:id="@+id/edtClaveRegistro"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:hint="@string/hint_clave"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/edtRepetirClaveRegistro"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:hint="@string/hint_repetir_clave"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/txtPreguntaRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/pregunta_objetivo"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbAhorrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/opt_objetivo_ahorrar"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbControlarDiario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/opt_objetivo_diario"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbReducirDeudas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/opt_objetivo_deudas"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbPresupuestoHogar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/opt_objetivo_hogar"
                android:textColor="@color/texto_principal" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/chkTerminosRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/chk_terminos"
            android:textColor="@color/texto_principal" />

        <Button
            android:id="@+id/btnCrearCuenta"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_crear_cuenta" />

        <TextView
            android:id="@+id/txtIrAlLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="@string/txt_ir_al_login"
            android:textColor="@color/primario"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
