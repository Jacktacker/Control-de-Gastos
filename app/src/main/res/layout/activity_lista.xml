<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ListaActivity">

    <!-- Barra superior con título y acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTituloLista"
            style="@style/TituloPantalla"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/titulo_lista" />

        <ImageButton
            android:id="@+id/btnIA"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/desc_btn_ia"
            android:src="@android:drawable/star_big_on"
            app:tint="@color/primario" />

        <ImageButton
            android:id="@+id/btnAgregar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/desc_btn_agregar"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/primario" />

        <ImageButton
            android:id="@+id/btnSalir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/desc_btn_salir"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/peligro" />
    </LinearLayout>

    <!-- Tarjeta de resumen mensual -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_tarjeta"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtResumenTitulo"
            style="@style/SubtituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resumen_mes_titulo" />

        <TextView
            android:id="@+id/txtResumenMonto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/resumen_mes_monto"
            android:textColor="@color/primario"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtResumenPresupuesto"
            style="@style/SubtituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/resumen_presupuesto" />
    </LinearLayout>

    <!-- Lista desplazable de gastos de ejemplo -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Fila 1 -->
            <LinearLayout
                android:id="@+id/filaGasto1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tarjeta"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgGasto1Lista"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/desc_icono_gasto"
                    android:src="@drawable/ic_logo_gastos" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtGasto1Lista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gasto_1_titulo"
                        android:textColor="@color/texto_principal"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSubtituloGasto1Lista"
                        style="@style/SubtituloPantalla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gasto_1_detalle" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto_1_monto"
                    android:textColor="@color/peligro"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fila 2 -->
            <LinearLayout
                android:id="@+id/filaGasto2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tarjeta"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgGasto2Lista"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/desc_icono_gasto"
                    android:src="@drawable/ic_logo_gastos" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtGasto2Lista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gasto_2_titulo"
                        android:textColor="@color/texto_principal"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSubtituloGasto2Lista"
                        style="@style/SubtituloPantalla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gasto_2_detalle" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto_2_monto"
                    android:textColor="@color/peligro"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fila 3 -->
            <LinearLayout
                android:id="@+id/filaGasto3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tarjeta"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgGasto3Lista"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/desc_icono_gasto"
                    android:src="@drawable/ic_logo_gastos" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtGasto3Lista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gasto_3_titulo"
                        android:textColor="@color/texto_principal"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSubtituloGasto3Lista"
                        style="@style/SubtituloPantalla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gasto_3_detalle" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto_3_monto"
                    android:textColor="@color/peligro"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fila 4 -->
            <LinearLayout
                android:id="@+id/filaGasto4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tarjeta"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgGasto4Lista"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/desc_icono_gasto"
                    android:src="@drawable/ic_logo_gastos" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtGasto4Lista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gasto_4_titulo"
                        android:textColor="@color/texto_principal"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSubtituloGasto4Lista"
                        style="@style/SubtituloPantalla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gasto_4_detalle" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto_4_monto"
                    android:textColor="@color/peligro"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fila 5 -->
            <LinearLayout
                android:id="@+id/filaGasto5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tarjeta"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgGasto5Lista"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/desc_icono_gasto"
                    android:src="@drawable/ic_logo_gastos" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtGasto5Lista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gasto_5_titulo"
                        android:textColor="@color/texto_principal"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSubtituloGasto5Lista"
                        style="@style/SubtituloPantalla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gasto_5_detalle" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gasto_5_monto"
                    android:textColor="@color/peligro"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
